{
  "schema": "dspx8s-preset/1",
  "name": "13 高速公路（路噪補償）",
  "description": "高速行駛時，胎噪和風切聲會蓋住低頻和人聲，這組把被蓋住的部分補回來。停車時聽會覺得低音太多，屬正常。",
  "channelGroups": { "front": [1, 2], "rear": [3, 4] },
  "eq": {
    "front": [
      { "f": 63, "g": 3, "q": 1.0, "note": "被路噪蓋住的低頻" },
      { "f": 125, "g": 2, "q": 1.2 },
      { "f": 250, "g": 1, "q": 1.5 },
      { "f": 2500, "g": 1.5, "q": 1.5, "note": "人聲不被風切聲蓋過" },
      { "f": 4000, "g": 1, "q": 1.5 }
    ],
    "rear": [
      { "f": 125, "g": 1.5, "q": 1.2 }
    ]
  }
}
