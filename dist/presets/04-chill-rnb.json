{
  "schema": "dspx8s-preset/1",
  "name": "04 Chill R&B / Hip-hop",
  "description": "深而不轟的低頻、溫暖的中頻、放鬆的高頻。",
  "channelGroups": { "front": [1, 2], "rear": [3, 4] },
  "eq": {
    "front": [
      { "f": 31.5, "g": 2.5, "q": 1.0, "note": "極低頻的深度" },
      { "f": 50, "g": 3.5, "q": 1.2, "note": "808 的主體" },
      { "f": 80, "g": 1.5, "q": 1.5 },
      { "f": 160, "g": -2, "q": 1.5, "note": "門板共振仍要壓" },
      { "f": 400, "g": 1, "q": 1.5, "note": "溫暖" },
      { "f": 2000, "g": -1, "q": 1.5, "note": "放鬆" },
      { "f": 4000, "g": -1.5, "q": 2.0 },
      { "f": 8000, "g": -2.5, "q": 1.5, "note": "高頻收起來" },
      { "f": 12500, "g": -1, "q": 1.2 }
    ],
    "rear": [
      { "f": 160, "g": -2, "q": 1.5 },
      { "f": 2500, "g": -2, "q": 1.5 }
    ]
  },
  "levelDb": { "front": 0, "rear": -2 },
  "delayCm": { "1": null, "2": null, "3": null, "4": null },
  "sub": { "lpfHz": 90, "phase": "現場測", "gain": "中偏高" },
  "notes": ["這組後聲道稍大，追求包圍感。", "若前門中低音在 50 Hz 開始失真，把 50 減到 +2，讓重低音本體的增益補上。"]
}
