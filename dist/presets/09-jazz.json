{
  "schema": "dspx8s-preset/1",
  "name": "09 爵士",
  "description": "低音提琴溫暖、管樂有存在感、鈸不刺耳。也適合 Bossa Nova 和輕音樂。",
  "channelGroups": { "front": [1, 2], "rear": [3, 4] },
  "eq": {
    "front": [
      { "f": 80, "g": 2, "q": 1.2, "note": "低音提琴" },
      { "f": 125, "g": 1, "q": 1.5 },
      { "f": 250, "g": -1.5, "q": 1.5 },
      { "f": 1250, "g": 1, "q": 1.5, "note": "薩克斯風與小號" },
      { "f": 4000, "g": -1, "q": 1.5 },
      { "f": 6300, "g": -1.5, "q": 2.0, "note": "鈸不刺" },
      { "f": 12500, "g": 1.5, "q": 1.2, "note": "鼓刷的細節" }
    ],
    "rear": [
      { "f": 250, "g": -1.5, "q": 1.5 },
      { "f": 4000, "g": -2, "q": 1.5 }
    ]
  }
