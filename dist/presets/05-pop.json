{
  "schema": "dspx8s-preset/1",
  "name": "05 西洋流行",
  "description": "低音有份量、人聲往前、高頻帶一點亮度的通用流行曲線。不確定選哪個就從這組開始。",
  "channelGroups": { "front": [1, 2], "rear": [3, 4] },
  "eq": {
    "front": [
      { "f": 63, "g": 2.5, "q": 1.2, "note": "大鼓與貝斯的份量" },
      { "f": 100, "g": 1, "q": 1.5 },
      { "f": 200, "g": -2, "q": 1.5, "note": "收掉門板的嗡聲" },
      { "f": 400, "g": -1, "q": 1.5, "note": "減少悶感" },
      { "f": 3150, "g": 1.5, "q": 1.5, "note": "人聲往前" },
      { "f": 6300, "g": -1.5, "q": 2.0, "note": "齒音" },
      { "f": 10000, "g": 1.5, "q": 1.2, "note": "亮度" },
      { "f": 16000, "g": 1, "q": 1.2 }
