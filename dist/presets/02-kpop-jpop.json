{
  "schema": "dspx8s-preset/1",
  "name": "02 K-pop / J-pop",
  "description": "編曲密、壓縮重、高頻亮的混音。目標是鼓點紮實、人聲清楚、齒音不刺。",
  "channelGroups": { "front": [1, 2], "rear": [3, 4] },
  "eq": {
    "front": [
      { "f": 50, "g": 3, "q": 1.2, "note": "大鼓與 808 的衝擊" },
      { "f": 80, "g": 1, "q": 1.5, "note": "低音線條" },
      { "f": 160, "g": -3, "q": 1.5, "note": "收緊，避免門板嗡嗡" },
      { "f": 315, "g": -1, "q": 1.5, "note": "減少悶感" },
      { "f": 1000, "g": -1, "q": 1.5, "note": "密集編曲在這裡容易擠，退一點" },
      { "f": 2500, "g": 1.5, "q": 1.5, "note": "人聲清晰度" },
      { "f": 5000, "g": -1, "q": 2.0, "note": "合成器與高音直射的尖" },
      { "f": 7000, "g": -2.5, "q": 1.5, "note": "齒音、hi-hat 過亮" },
      { "f": 12500, "g": 1.5, "q": 1.2, "note": "亮度與空氣感" },
      { "f": 16000, "g": 1, "q": 1.2 }
    ],
    "rear": [
      { "f": 160, "g": -3, "q": 1.5 },
      { "f": 315, "g": -1, "q": 1.5 },
      { "f": 2500, "g": -2, "q": 1.5, "note": "後方不搶人聲" },
      { "f": 5000, "g": -2, "q": 2.0 }
    ]
  },
  "levelDb": { "front": 0, "rear": -3 },
  "delayCm": { "1": null, "2": null, "3": null, "4": null },
  "sub": { "lpfHz": 80, "phase": "現場測", "gain": "中偏高" },
  "notes": ["覺得太亮就先把 12500 與 16000 歸零，不要再減 7000。", "覺得低音散就把 50 Hz 減到 +2，160 Hz 減到 -4。"]
}
