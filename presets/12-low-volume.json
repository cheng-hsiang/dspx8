{
  "schema": "dspx8s-preset/1",
  "name": "12 小音量補償",
  "description": "小聲聽的時候，耳朵聽不太到低音和高音，這組把兩端補起來。只適合小音量；音量開大請換別組，不然會又轟又刺。",
  "channelGroups": { "front": [1, 2], "rear": [3, 4] },
  "eq": {
    "front": [
      { "f": 50, "g": 4, "q": 0.8, "note": "小聲時聽不到的低頻" },
      { "f": 125, "g": 1.5, "q": 1.2 },
      { "f": 10000, "g": 3, "q": 0.9, "note": "小聲時聽不到的高頻" },
      { "f": 16000, "g": 1.5, "q": 1.2 }
    ],
    "rear": [
      { "f": 63, "g": 2, "q": 1.0 }
    ]
  }
}
