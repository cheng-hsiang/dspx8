{
  "schema": "dspx8s-preset/1",
  "name": "11 重低音加強",
  "description": "低頻往上推，想要震撼感的時候用。開大聲時如果破音，把 40 和 63 Hz 各減 1 到 2 dB。",
  "channelGroups": { "front": [1, 2], "rear": [3, 4] },
  "eq": {
    "front": [
      { "f": 40, "g": 3, "q": 1.0, "note": "超低頻" },
      { "f": 63, "g": 4, "q": 1.2, "note": "主要的低音" },
      { "f": 100, "g": 1.5, "q": 1.5 },
      { "f": 160, "g": -2, "q": 1.5, "note": "收緊，低音才不會糊" },
      { "f": 250, "g": -1.5, "q": 1.5 }
    ],
    "rear": [
      { "f": 160, "g": -2, "q": 1.5 },
      { "f": 250, "g": -1.5, "q": 1.5 }
    ]
  },
  "notes": ["沒有重低音喇叭的車，門板喇叭推這麼多容易破音，請從小聲開始試。"]
}
