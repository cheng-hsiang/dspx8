{
  "schema": "dspx8s-preset/1",
  "name": "10 人聲清晰（Podcast / 廣播）",
  "description": "把說話用不到的低頻拿掉、咬字的頻段往前。聽 Podcast、廣播、有聲書、導航語音時用。聽音樂會覺得單薄，屬正常。",
  "channelGroups": { "front": [1, 2], "rear": [3, 4] },
  "eq": {
    "front": [
      { "f": 63, "g": -3, "q": 1.0, "note": "說話用不到的低頻" },
      { "f": 125, "g": -2, "q": 1.2 },
      { "f": 250, "g": -1.5, "q": 1.5, "note": "鼻音與悶" },
      { "f": 1600, "g": 1.5, "q": 1.5 },
      { "f": 2500, "g": 2.5, "q": 1.5, "note": "咬字" },
      { "f": 4000, "g": 1.5, "q": 1.5 },
      { "f": 6300, "g": -1, "q": 2.0, "note": "齒音" },
      { "f": 10000, "g": -1, "q": 1.2 }
    ],
    "rear": [
      { "f": 125, "g": -2, "q": 1.2 },
      { "f": 250, "g": -1.5, "q": 1.5 }
    ]
  }
}
