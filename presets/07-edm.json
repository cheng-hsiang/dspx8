{
  "schema": "dspx8s-preset/1",
  "name": "07 電子舞曲 EDM",
  "description": "超低頻和大鼓往上推，中低頻挖乾淨，高頻加亮。適合電音、舞曲、Trap。",
  "channelGroups": { "front": [1, 2], "rear": [3, 4] },
  "eq": {
    "front": [
      { "f": 40, "g": 3, "q": 1.0, "note": "超低頻" },
      { "f": 63, "g": 3, "q": 1.2, "note": "kick 的衝擊" },
      { "f": 125, "g": -1, "q": 1.5 },
      { "f": 200, "g": -2.5, "q": 1.5, "note": "讓低音乾淨不糊" },
      { "f": 500, "g": -1, "q": 1.5 },
      { "f": 2000, "g": 1, "q": 1.5, "note": "合成器主旋律" },
      { "f": 4000, "g": 1, "q": 1.5 },
      { "f": 6300, "g": -1.5, "q": 2.0, "note": "高頻太刺的地方" },
      { "f": 10000, "g": 2, "q": 1.2, "note": "亮度" },
      { "f": 16000, "g": 1.5, "q": 1.2 }
    ],
    "rear": [
      { "f": 200, "g": -2.5, "q": 1.5 },
      { "f": 500, "g": -1, "q": 1.5 },
      { "f": 4000, "g": -2, "q": 1.5 }
    ]
  },
  "notes": ["開大聲破音：把 40 和 63 Hz 各減 1 到 2 dB。"]
}
