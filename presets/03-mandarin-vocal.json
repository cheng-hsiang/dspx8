{
  "schema": "dspx8s-preset/1",
  "name": "03 華語抒情",
  "description": "以人聲為中心，低頻收斂、中頻自然、高頻柔順。",
  "channelGroups": { "front": [1, 2], "rear": [3, 4] },
  "eq": {
    "front": [
      { "f": 40, "g": 1, "q": 1.0, "note": "只要一點厚度" },
      { "f": 125, "g": -1.5, "q": 1.5, "note": "抒情歌的低音鼓與 bass 容易糊在這" },
      { "f": 250, "g": -1, "q": 1.5 },
      { "f": 800, "g": 1, "q": 1.5, "note": "人聲的胸腔與溫度" },
      { "f": 3150, "g": 1.5, "q": 1.5, "note": "歌詞聽得清楚" },
      { "f": 6300, "g": -1.5, "q": 2.0, "note": "齒音" },
      { "f": 10000, "g": 1, "q": 1.2, "note": "一點空氣感，不要更多" }
    ],
    "rear": [
      { "f": 160, "g": -2, "q": 1.5 },
      { "f": 3150, "g": -1.5, "q": 1.5 }
    ]
  },
  "levelDb": { "front": 0, "rear": -4 },
  "delayCm": { "1": null, "2": null, "3": null, "4": null },
  "sub": { "lpfHz": 80, "phase": "現場測", "gain": "中偏低" },
  "notes": ["人聲若覺得太前、太薄，把 3150 減到 +0.5，800 加到 +1.5。"]
}
